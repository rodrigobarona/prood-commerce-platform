{
  "$schema": "https://v2-9-16.turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "VERCEL",
    "DASHBOARD_ORIGIN",
    "ADMIN_ORIGIN",
    "DOCS_ORIGIN",
    "CHECKOUT_ORIGIN",
    "API_ORIGIN",
    "NEXT_PHASE",
    "DATABASE_URL",
    "ADMIN_EMAIL",
    "ADMIN_PASSWORD",
    "VERCEL_TOKEN",
    "STOREFRONT_VERCEL_PROJECT_ID",
    "VERCEL_TEAM_ID",
    "AUTH_COOKIE_DOMAIN",
    "PASSKEY_RP_ID",
    "PASSKEY_ORIGINS",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_SECRET",
    "API_PUBLIC_URL",
    "COMMERCE_API_URL",
    "CHECKOUT_URL",
    "CHECKOUT_API_SECRET",
    "STOREFRONT_REVALIDATE_SECRET",
    "AUTH_PROXY_SECRET",
    "TRUST_PROXY",
    "INTEGRATION_ENCRYPTION_KEY",
    "S3_*",
    "KV_REST_API_URL",
    "KV_REST_API_TOKEN",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "BILLING_MODE",
    "CRON_SECRET",
    "BILLING_STRIPE_SECRET_KEY",
    "BILLING_STRIPE_WEBHOOK_SECRET",
    "NEXT_PUBLIC_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "db:seed": {
      "cache": false,
      "dependsOn": [
        "build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "email:dev": {
      "cache": false,
      "persistent": true
    }
  }
}
