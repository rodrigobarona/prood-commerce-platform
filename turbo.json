{
  "$schema": "https://v2-9-16.turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PHASE",
    "DATABASE_URL",
    "ADMIN_EMAIL",
    "ADMIN_PASSWORD",
    "VERCEL_TOKEN",
    "STOREFRONT_VERCEL_PROJECT_ID",
    "VERCEL_TEAM_ID",
    "COMMERCE_CURRENCY",
    "STORAGE_PROVIDER",
    "AUTH_COOKIE_DOMAIN",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_SECRET",
    "API_PUBLIC_URL",
    "COMMERCE_API_URL",
    "CHECKOUT_URL",
    "CHECKOUT_API_SECRET",
    "AGENT_PROXY_API_KEYS_BY_ORG",
    "TRUST_PROXY",
    "INTEGRATION_ENCRYPTION_KEY",
    "BLOB_READ_WRITE_TOKEN",
    "S3_*",
    "KV_REST_API_URL",
    "KV_REST_API_TOKEN",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "NEXT_PUBLIC_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "dependsOn": [
        "^build"
      ]
    },
    "db:migrate:seed": {
      "cache": false,
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "email:dev": {
      "cache": false,
      "persistent": true
    }
  }
}
