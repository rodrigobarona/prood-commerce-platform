# ---------------------------------------------------------------------------
# Prood — local environment
# Copy to the repo root as `.env.local`, then run `pnpm env:link` to generate
# per-app `.env.local` files with the right auth URLs for each app.
#
# Every variable below is required unless marked optional. There are no
# built-in defaults: a missing value fails fast with a clear error.
# ---------------------------------------------------------------------------

# --- Database (Neon Postgres) ---------------------------------------------
# Provisioned by the Vercel Neon integration. Shared by commerce + auth.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Secrets (generate each with: openssl rand -base64 32) ----------------
BETTER_AUTH_SECRET=""
CHECKOUT_API_SECRET=""
# Dashboard and admin send it in a header next to the client address they pass to
# apps/api, which believes that address only when the secret matches and keys auth
# rate limits on it. Set the same value on api, dashboard and admin.
AUTH_PROXY_SECRET=""
# api and dashboard send it to the storefront's /api/revalidate when a store's
# catalog or details change. Set the same value on api, dashboard and storefront.
STOREFRONT_REVALIDATE_SECRET=""
# AES-256-GCM key for stored payment/integration credentials
INTEGRATION_ENCRYPTION_KEY=""

# --- Demo admin (`pnpm db:seed` only) ------------------------------------
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-local-only"

# --- Stores ----------------------------------------------------------------
# Stores are served from {slug}.{NEXT_PUBLIC_PLATFORM_DOMAIN} or a verified
# custom domain. Locally, browsers resolve *.localhost, so the demo store is
# http://prood-demo.localhost:3000. Production: prood.app
NEXT_PUBLIC_PLATFORM_DOMAIN="localhost"

# --- Storage ----------------------------------------------------------------
# Cloudflare R2 through its S3 API. The key is scoped to this bucket only.
S3_ENDPOINT="https://<account>.eu.r2.cloudflarestorage.com"
S3_BUCKET="prood-public"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public origin of the media Worker. next/image and image validation allow it.
S3_PUBLIC_URL="https://prood-media.rbarona.workers.dev"
# Only for `pnpm --filter @prood/media media:build`, which fetches originals from Pexels.
PEXELS_API_KEY=""

# --- Redis: checkout sessions and auth rate limits (Upstash, Vercel Marketplace)
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=""
# onboarding@resend.dev only delivers to the Resend account owner. Use a
# verified domain to send to anyone else.
RESEND_FROM_EMAIL="Prood <onboarding@resend.dev>"

# --- Payments --------------------------------------------------------------
# None here. Each store connects its own Stripe / Easypay / Ifthenpay account
# in Dashboard → Integrations; credentials are stored encrypted per store.

# --- App URLs ----------------------------------------------------------------
# Production: prood.com, dashboard.prood.com, api.prood.com, checkout.prood.com,
# docs.prood.com, admin.prood.com; stores on *.prood.app.
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
# Storefront apex, never a single store: https://prood.app in production.
NEXT_PUBLIC_STOREFRONT_URL="http://localhost:3000"
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3002"
NEXT_PUBLIC_DOCS_URL="http://localhost:3003"
CHECKOUT_URL="http://localhost:3004"
NEXT_PUBLIC_API_URL="http://localhost:3005"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3006"
# Auth issuer (apps/api). link-env.sh writes BETTER_AUTH_URL per app.
NEXT_PUBLIC_AUTH_URL="http://localhost:3005"
API_PUBLIC_URL="http://localhost:3005"
COMMERCE_API_URL="http://localhost:3005/v1"
# Shared cookie domain for dashboard + API (production only), e.g. ".prood.com"
# AUTH_COOKIE_DOMAIN=""

# --- Passkeys (apps/api, dashboard, admin; optional) --------------------------
# Leave both empty to keep passkeys off: no routes, no buttons. Set both on api,
# dashboard and admin to turn them on. The ID must be a registrable domain
# suffix of every origin, so it can't be a *.vercel.app host (a public suffix).
# Use the apps' own domains, e.g. PASSKEY_RP_ID="prood.com" with
# PASSKEY_ORIGINS="https://dashboard.prood.com,https://admin.prood.com".
# Locally: PASSKEY_RP_ID="localhost" and PASSKEY_ORIGINS="http://localhost:3002,http://localhost:3006".
PASSKEY_RP_ID=""
PASSKEY_ORIGINS=""

# --- Agent Auth (apps/api) -------------------------------------------------
# Proxied agent calls are signed with a key derived from BETTER_AUTH_SECRET.
TRUST_PROXY="false"

# --- Custom domains (apps/dashboard, optional locally) ---------------------
# STOREFRONT_VERCEL_PROJECT_ID is the storefront project (not VERCEL_PROJECT_ID,
# which Vercel overrides with the current project's id).
VERCEL_TOKEN=""
STOREFRONT_VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# --- Address autocomplete (optional) ----------------------------------------
NEXT_PUBLIC_GEOAPIFY_API_KEY=""
