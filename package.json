{
  "name": "prood",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "turbo run lint typecheck test build",
    "openapi:sync": "pnpm --filter docs sync:openapi",
    "openapi:check": "pnpm --filter docs sync:openapi -- --check && pnpm --filter @prood/api-client codegen:check",
    "api-client:codegen": "pnpm --filter @prood/api-client codegen",
    "prood": "pnpm --filter @prood/cli cli",
    "db:generate": "pnpm --filter @prood/platform db:generate",
    "db:migrate": "pnpm --filter @prood/platform db:migrate",
    "db:seed": "turbo run db:seed --filter=@prood/platform",
    "env:link": "bash scripts/link-env.sh",
    "catalog:apply": "node scripts/apply-catalog.mjs"
  },
  "devDependencies": {
    "@prood/eslint-config": "workspace:*",
    "@prood/typescript-config": "workspace:*",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  }
}
